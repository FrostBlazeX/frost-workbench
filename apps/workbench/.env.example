# Copy this file to .env.local (git-ignored) and fill in real values.
# On Vercel, add the same names under Project Settings → Environment Variables.
# These are server-only: without a NEXT_PUBLIC_ prefix, Next.js never sends them to the browser.

# Base URL of the RAG service, no trailing slash.
RAG_API_URL=https://frost-arena-rag.onrender.com

# API key the RAG service expects on /ask.
RAG_API_KEY=""