{
  "name": "frost-workbench",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "storybook": "pnpm --filter @frost/ui storybook",
    "build-storybook": "turbo run build-storybook"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "turbo": "^2.11.10",
    "typescript": "^7.0.2"
  }
}
